- [pyais_toolkit_message_type_28_0, nmea_list, pyais_toolkit_nmea_to_nmea_bits_0, nmea_list]
- [pyais_toolkit_message_type_28_1, nmea_list, pyais_toolkit_nmea_to_nmea_bits_0, nmea_list]
- [pyais_toolkit_message_type_28_2, nmea_list, pyais_toolkit_nmea_to_nmea_bits_0, nmea_list]
