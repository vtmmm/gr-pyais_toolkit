options:
  parameters:
    author: user
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: 'Run ais-simulator_to_burst_file.grc to generate an IQ

      file from these messages.


      This creates AIS messages of a vessel

      moving at 20 knots with a course and

      heading of 45 degrees starting at 38, -78.'
    copyright: ''
    description: ''
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: msg1_example
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: AIS Message Type 1 example
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: pyais_toolkit_message_type_1_0
  id: pyais_toolkit_message_type_1
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    course: '45'
    heading: '45'
    latitude: '0.0'
    longitude: '0.0'
    maxoutbuf: '0'
    minoutbuf: '0'
    mmsi: '338123456'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [488, 264.0]
    rotation: 0
    state: enabled
- name: pyais_toolkit_nmea_to_nmea_bits_0
  id: pyais_toolkit_nmea_to_nmea_bits
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [552, 416.0]
    rotation: 180
    state: enabled
- name: pyais_toolkit_strobe_latlon_moving_0
  id: pyais_toolkit_strobe_latlon_moving
  parameters:
    affinity: ''
    alias: ''
    bearing: '45'
    comment: ''
    initial_delay: '0.0'
    interval: '.5'
    lat_ref: '38'
    lon_ref: '-75'
    maxoutbuf: '0'
    minoutbuf: '0'
    speed: '20'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [176, 212.0]
    rotation: 0
    state: enabled
- name: zeromq_pub_msg_sink_0
  id: zeromq_pub_msg_sink
  parameters:
    address: tcp://127.0.0.1:7070
    affinity: ''
    alias: ''
    bind: 'True'
    comment: ''
    timeout: '100'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [240, 412.0]
    rotation: 180
    state: enabled

connections:
- [pyais_toolkit_message_type_1_0, nmea_list, pyais_toolkit_nmea_to_nmea_bits_0, nmea_list]
- [pyais_toolkit_nmea_to_nmea_bits_0, nmea_bits, zeromq_pub_msg_sink_0, in]
- [pyais_toolkit_strobe_latlon_moving_0, latlon, pyais_toolkit_message_type_1_0, latlon]

metadata:
  file_format: 1
  grc_version: v3.10.11.0-64-g35346914
